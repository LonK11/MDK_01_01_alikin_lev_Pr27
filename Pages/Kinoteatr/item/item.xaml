<UserControl x:Class="KINO_Alikin_2.Pages.Kinoteatr.item.item"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:KINO_Alikin_2.Pages.Kinoteatr.item"
             mc:Ignorable="d" >

    <Grid Margin="10" Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100px"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Image Height="80" Width="80" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="10" Source="/Images/ic_kinoteatr.png"/>
        <Label  Content="Наименование:" Grid.Column="1" Margin="10" VerticalAlignment="Top"/>
        <TextBox x:Name="name" Height="25" Grid.Column="1" Margin="10,36,10,0" IsEnabled="False" VerticalAlignment="Top"/>
        <Label  Content="Количество:" Grid.Column="2" Margin="10,10,10,0" VerticalAlignment="Top"/>
        <TextBox x:Name="count" Height="25" Grid.Column="2" Margin="10,36,10,0" IsEnabled="False" VerticalAlignment="Top"/>
        <Label  Content="Количество залов:" Grid.Column="1" Margin="10,72,10,0" VerticalAlignment="Top"/>
        <TextBox x:Name="countZal" Height="25" Grid.Column="1" Margin="10,103,10,0" IsEnabled="False" VerticalAlignment="Top"/>

        <Button Click="EditRecord" Content="Изменить" Height="25" Width="80" Margin="0,100,0,0" HorizontalAlignment="Center" Background="#FF9E34FB" Foreground="White" BorderBrush="#FF9E34FB" VerticalAlignment="Top" />
        <Button Click="DeleteRecord"  Content="Удалить" Height="25" Width="80" Margin="0,130,0,10" HorizontalAlignment="Center" Background="#FF34FB89" Foreground="White" BorderBrush="#FF34FB89" VerticalAlignment="Top" />
    </Grid>
</UserControl>
