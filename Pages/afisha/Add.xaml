<Page x:Class="KINO_Alikin_2.Pages.afisha.Add"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:KINO_Alikin_2.Pages.afisha"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Add">

    <Grid Background="Gainsboro">
        <Grid Margin="20" Background="White">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100px"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Image Height="80" Width="80" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="10" Source="/Images/ic_afisha.png"/>
            <Label  Content="Кинотеатр:" Grid.Column="1" Margin="10" VerticalAlignment="Top"/>
            <ComboBox x:Name="kinoteatrs" Height="25" Grid.Column="1" Margin="10,36,10,0" VerticalAlignment="Top"/>
            <Label  Content="Дата:" Grid.Column="2" Margin="10,10,10,0" VerticalAlignment="Top"/>
            <DatePicker x:Name="date" Height="25" Grid.Column="2" Margin="10,36,147,0" VerticalAlignment="Top"/>
            <TextBox x:Name="time" Height="25" Grid.Column="2" Margin="188,36,10,0" VerticalAlignment="Top"/>
            <Label  Content="Стоимость:" Grid.Column="2" Margin="10,72,10,0" VerticalAlignment="Top"/>
            <TextBox x:Name="price" Height="25" Grid.Column="2" Margin="10,103,10,0" VerticalAlignment="Top"/>
            <Label  Content="Наименование:" Grid.Column="1" Margin="10,72,10,0" VerticalAlignment="Top"/>
            <TextBox x:Name="name" Height="25" Grid.Column="1" Margin="10,103,10,0" VerticalAlignment="Top"/>

            <Button x:Name="btnAdd" Click="AddRecord" Content="Добавить" Height="25" Width="100" Grid.Column="2" Margin="0,133,10,0" HorizontalAlignment="Right" Background="#FF9E34FB" Foreground="White" BorderBrush="#FF9E34FB" VerticalAlignment="Top" />
        </Grid>
    </Grid>
</Page>
